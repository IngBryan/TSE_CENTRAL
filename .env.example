# Variables que lee docker-compose.yml. Copiar a .env y completar: .env esta en .gitignore y los
# secretos no se commitean.
# Para generar claves aleatorias: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# RabbitMQ
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
#POSTGRES_PORT=5432

# MongoDB
MONGO_USER=
MONGO_PASSWORD=
#MONGO_PORT=27017

# PDI (validacion de datos de personas)
PDI_ORGANISMO_CODIGO=
PDI_ORGANISMO_CLAVE=
#PDI_URL=http://host.docker.internal:3005/ws/servicioInformacion

# Clave que exige la API REST de frontofficeciudadanos-web (header X-Api-Key)
CIUDADANOS_API_KEY=
# Clave que exige la API REST de frontofficefuncionarios-web. Tiene que ser distinta de CIUDADANOS_API_KEY.
FUNCIONARIOS_API_KEY=
# Ingreso de testing en el front de ciudadanos (cedula, sin gub.uy). Prende LOGIN_TESTING del front e
# INGRESO_TESTING de WildFly. Solo para pruebas.
#CIUDADANOS_LOGIN_TESTING=false

# Usuario de aplicacion de WildFly para EJB remoto (lo crea wildfly/start.sh; lo usa Fiscalizacionautomatica)
EJB_USER=
EJB_PASSWORD=

# Poller de balanzas (Fiscalizacionautomatica): credenciales OAuth de la API de balanzas (TSE_NODOS)
BALANZAS_CLIENT_ID=
BALANZAS_CLIENT_SECRET=
#BALANZAS_URL=http://host.docker.internal:3001

# Frontoffice ciudadanos: login con ID Uruguay (gub.uy) y cookie de sesion
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET=
# App movil del chofer: firma el JWT de /api/movil/* (al menos 32 caracteres)
MOVIL_TOKEN_SECRET=
# Backoffice: firma el JWT que reemplaza a la sesion en WildFly (al menos 32 caracteres, distinto del de la app)
BACKOFFICE_JWT_SECRET=

# Frontoffice funcionarios: cifra la cookie de sesion. Tiene que ser distinta de SESSION_SECRET.
FUNCIONARIOS_SESSION_SECRET=

# Infracciones: dias corridos desde la notificacion para presentar el descargo (10 por defecto)
#PLAZO_DESCARGO_DIAS=10
# Infracciones: con false no se pasan solos a EN_DESCARGO los casos con el plazo vencido sin descargo
#VENCIMIENTO_DESCARGO_ACTIVO=true
# Portal publico: minimo de empresas distintas para publicar un numero estadistico (nunca menos de 3)
#PORTAL_UMBRAL_EMPRESAS=3
# Ingreso de testing en el front de funcionarios (cedula, sin gub.uy; WildFly igual controla funcionario y
# PDI). Prendido por defecto en local porque la redirect URI de gub.uy de localhost:3003 no esta registrada.
#FUNCIONARIOS_LOGIN_TESTING=true
