# Variables que lee docker-compose.yml. Copiar a .env y completar: .env esta en .gitignore y los
# secretos no se commitean.
# Para generar claves aleatorias: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# RabbitMQ
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
#POSTGRES_PORT=5432

# MongoDB
MONGO_USER=
MONGO_PASSWORD=
#MONGO_PORT=27017

# PDI (validacion de datos de personas)
PDI_ORGANISMO_CODIGO=
PDI_ORGANISMO_CLAVE=
#PDI_URL=http://host.docker.internal:3005/ws/servicioInformacion

# Clave que exigen las API REST de WildFly (header X-Api-Key); la usan los dos frontoffice
BACKEND_API_KEY=

# Frontoffice ciudadanos: login con ID Uruguay (gub.uy) y cookie de sesion
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET=
# App movil del chofer: firma el JWT de /api/movil/* (al menos 32 caracteres)
MOVIL_TOKEN_SECRET=

# Frontoffice funcionarios: cifra la cookie de sesion. Tiene que ser distinta de SESSION_SECRET.
FUNCIONARIOS_SESSION_SECRET=
