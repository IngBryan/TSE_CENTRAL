<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.2">
    <persistence-unit name="frontofficeciudadanosTestPersistenceUnit" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>tse.lab.model.Empresa</class>
        <class>tse.lab.model.Guia</class>
        <class>tse.lab.model.Localidad</class>
        <class>tse.lab.model.RutaReferencia</class>
        <class>tse.lab.model.GuiaRutaAutorizada</class>
        <class>tse.lab.model.Vehiculo</class>
        <class>tse.lab.model.PermisoCirculacion</class>
        <class>tse.lab.model.ITV</class>
        <class>tse.lab.model.Chofer</class>
        <class>tse.lab.model.Responsable</class>
        <class>tse.lab.model.Ciudadano</class>
        <class>tse.lab.model.RegistroConsultaPersona</class>
        <class>tse.lab.model.EventoViaje</class>
        <class>tse.lab.model.ModificacionGuia</class>
        <!-- Pesajes (PesajesService) y lo que referencian: balanzas y casos de fiscalizacion -->
        <class>tse.lab.model.EventoPesajes</class>
        <class>tse.lab.model.ClaveEvento</class>
        <class>tse.lab.model.NodoPeriferico</class>
        <class>tse.lab.model.NodoBalanza</class>
        <class>tse.lab.model.NodoTracking</class>
        <class>tse.lab.model.CasoFiscalizacion</class>
        <class>tse.lab.model.Descargo</class>
        <class>tse.lab.model.FundamentoResolucion</class>
        <class>tse.lab.model.RegistroAuditoriaCaso</class>
        <class>tse.lab.model.UsuarioBackoffice</class>
        <class>tse.lab.model.Funcionario</class>
        <class>tse.lab.model.Autoridad</class>
        <class>tse.lab.model.Administrador</class>
        <properties>
            <property name="jakarta.persistence.validation.mode" value="NONE"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>