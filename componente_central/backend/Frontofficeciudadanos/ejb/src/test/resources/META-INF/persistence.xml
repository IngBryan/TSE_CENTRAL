<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.2">
    <persistence-unit name="frontofficeciudadanosTestPersistenceUnit" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>tse.lab.frontofficeciudadanos.model.Empresa</class>
        <class>tse.lab.frontofficeciudadanos.model.Guia</class>
        <class>tse.lab.frontofficeciudadanos.model.Vehiculo</class>
        <class>tse.lab.frontofficeciudadanos.model.Chofer</class>
        <class>tse.lab.frontofficeciudadanos.model.Responsable</class>
        <class>tse.lab.frontofficeciudadanos.model.PerfilCiudadano</class>
        <class>tse.lab.frontofficeciudadanos.model.RegistroConsultaPersona</class>
        <properties>
            <property name="jakarta.persistence.validation.mode" value="NONE"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>