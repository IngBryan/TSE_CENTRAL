<?xml version="1.0" encoding="UTF-8"?>
<web-app
    xmlns="https://jakarta.ee/xml/ns/jakartaee"
    version="6.0">

    <security-role>
        <role-name>ADMINISTRADOR</role-name>
    </security-role>

    <security-role>
        <role-name>AUTORIDAD</role-name>
    </security-role>

    <session-config>
        <session-timeout>30</session-timeout>

        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

</web-app>
