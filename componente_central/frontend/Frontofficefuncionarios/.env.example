# Para correr con npm run dev. Copiar a .env.local y completar: .env.local esta en .gitignore y los
# secretos no se commitean. En Docker estas variables salen del .env de la raiz (ver docker-compose.yml).

# Clave para cifrar la cookie de sesion (cualquier string largo y aleatorio, distinta de la de ciudadanos).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Backend Frontofficefuncionarios (WildFly). BACKEND_API_KEY tiene que ser la misma que recibe
# WildFly (FUNCIONARIOS_API_KEY del .env raiz).
BACKEND_API_KEY=

# Ingreso con cedula sin proveedor de identidad (hasta que se integre gub.uy).
LOGIN_TESTING=true

# Archivo con las URLs de la app y del backend (ver src/lib/config.ts). En Docker se monta
# config/docker.json en /app/config/app.json, que es el valor por defecto.
CONFIG_FILE=config/local.json
