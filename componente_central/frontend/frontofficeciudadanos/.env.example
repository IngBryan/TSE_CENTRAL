# Login con ID Uruguay (gub.uy) - ambiente de testing.
# Copiar a .env.local y completar. .env.local esta en .gitignore: el secret no se commitea.

OIDC_CLIENT_ID=890192
OIDC_CLIENT_SECRET=

# Debe ser EXACTAMENTE una redirect URI registrada (http://localhost o http://localhost:8080),
# por eso la app tiene que correr en el puerto 80 (npm run dev:gubuy o docker compose).
APP_BASE_URL=http://localhost
#OIDC_REDIRECT_URI=http://localhost
#OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost/logout

# Clave para cifrar las cookies de sesion (cualquier string largo y aleatorio).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcionales (estos son los valores por defecto)
#OIDC_ISSUER=https://auth-testing.iduruguay.gub.uy/oidc/v1
#OIDC_SCOPES=openid personal_info email document
#OIDC_JWKS_URI=https://auth-testing.iduruguay.gub.uy/oidc/v1/jwks
#OIDC_TIMEOUT_MS=8000
