          "legendFormat": "connections",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(mongodb_ss_wt_concurrentTransactions_write_normalPriority_queueLength{cluster=\"$cluster\"})",
          "legendFormat": "writes waiting",
          "refId": "B",
          "range": true
