        "h": 8,
        "w": 8,
        "x": 8,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (op_type) (rate(mongodb_ss_opLatencies_latency{cluster=\"$cluster\", op_type=~\"writes|reads\"}[$__rate_interval])) / sum by (op_type) (rate(mongodb_ss_opLatencies_ops{cluster=\"$cluster\", op_type=~\"writes|reads\"}[$__rate_interval]))",
          "legendFormat": "{{op_type}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
