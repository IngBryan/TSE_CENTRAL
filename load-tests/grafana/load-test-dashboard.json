        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (legacy_op_type) (rate(mongodb_ss_opcounters{cluster=\"$cluster\", legacy_op_type=~\"insert|update|query\"}[$__rate_interval]))",
          "legendFormat": "{{legacy_op_type}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
