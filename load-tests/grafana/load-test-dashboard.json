        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Average latency",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
