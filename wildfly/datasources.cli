# Driver de PostgreSQL y el datasource unico (java:/MainDS) que usan los persistence.xml de los
# 3 proyectos: todos comparten la misma base y las mismas tablas. Se aplica al construir la
# imagen (ver Dockerfile).
#
# Variables de entorno, resueltas al arrancar WildFly:
#   DB_HOST (por defecto postgres), DB_PORT (5432), DB_NAME (main_db), DB_USER, DB_PASSWORD

module add --name=org.postgresql --resources=/tmp/postgresql.jar --dependencies=javax.api,jakarta.transaction.api

embed-server --server-config=standalone.xml --std-out=echo

/subsystem=datasources/jdbc-driver=postgresql:add( \
    driver-name=postgresql, \
    driver-module-name=org.postgresql, \
    driver-xa-datasource-class-name=org.postgresql.xa.PGXADataSource)

/subsystem=datasources/data-source=MainDS:add( \
    jndi-name=java:/MainDS, \
    driver-name=postgresql, \
    connection-url=expression "jdbc:postgresql://${env.DB_HOST:postgres}:${env.DB_PORT:5432}/${env.DB_NAME:main_db}", \
    user-name=expression "${env.DB_USER}", \
    password=expression "${env.DB_PASSWORD}", \
    valid-connection-checker-class-name=org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLValidConnectionChecker, \
    background-validation=true)

# Seguridad HTTP del Backoffice.
# Las identidades se validan mediante Jakarta Security,
# consultando los usuarios persistidos en PostgreSQL.
/subsystem=undertow/application-security-domain=BackofficeSecurity:add(security-domain=ApplicationDomain, integrated-jaspi=false)

stop-embedded-server
